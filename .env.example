# LearnGeo configuration.
#
# Copy to .env for local use, or paste the lot into Railway's Variables tab
# (it accepts this format directly via "Raw Editor").
# .env is gitignored; .env.example is committed. Never put a real secret here.

# Signs the session cookie that holds your score and the answer to the
# question currently on screen. Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LEARNGEO_SECRET=change-me-to-a-long-random-string

# Where progress.db is written. Point this at a mounted volume, or every
# deploy wipes everyone's scores -- Railway containers have no persistent
# disk of their own. Set it to the volume's mount path.
# Leave unset locally and it uses ./data.
LEARNGEO_DATA_DIR=/data

# Supplied by the host. Only set it yourself when running locally on a
# different port.
# PORT=5000
